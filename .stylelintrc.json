{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "import",
          "plugin",
          "custom-variant",
          "theme",
          "apply",
          "layer",
          "responsive",
          "screen",
          "supports",
          "document"
        ]
      }
    ]
  }
}
